          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      {
        "properties": {
          "text": {
            "type": "string"
          },
          "type": {
            "const": "steer",
            "type": "string"
          }
        },
        "required": [
          "type",
          "text"
        ],
        "type": "object"
      },
      {
        "properties": {
          "text": {
            "type": "string"
          },
          "type": {
            "const": "follow_up",
            "type": "string"
          }
        },
        "required": [
          "type",
          "text"
        ],
        "type": "object"
      },
      {
        "properties": {
          "model": {
            "type": "string"
          },
