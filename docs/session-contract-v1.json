        "type": "string"
      }
    },
    "required": [
      "command_id"
    ],
    "title": "SessionCommand",
    "type": "object"
  },
  "create_session": {
    "$defs": {
      "PermissionPolicy": {
        "enum": [
          "ask",
          "deny",
          "allow"
        ],
        "type": "string"
      },
      "SessionBackend": {
        "description": "Session backends include native protocols that are not one-shot CLI runners.",
        "enum": [
          "claude",
          "codex",
          "pi",
          "cursor",
          "gemini",
          "opencode",
          "aikit",
          "grok",
          "antigravity"
        ],
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "backend": {
        "$ref": "#/$defs/SessionBackend"
      },
      "command_id": {
        "type": "string"
      },
      "cwd": {
        "type": "string"
      },
      "model": {
        "default": null,
        "type": [
          "string",
          "null"
        ]
      },
      "permission_policy": {
        "$ref": "#/$defs/PermissionPolicy",
        "default": "ask"
      },
      "prompt": {
        "type": "string"
      },
      "resume": {
        "default": null,
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "command_id",
      "backend",
      "cwd",
      "prompt"
    ],
    "title": "CreateSession",
    "type": "object"
  },
  "event": {
    "$defs": {
      "CommandFailure": {
        "properties": {
          "code": {
            "type": "string"
          },
          "retry": {
            "description": "Advice, never automatic authorization to repeat native side effects.",
            "type": "string"
          }
        },
        "required": [
          "code",
          "retry"
        ],
        "type": "object"
      },
      "CommandReceipt": {
        "properties": {
          "command_id": {
            "type": "string"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "failure": {
            "anyOf": [
              {
                "$ref": "#/$defs/CommandFailure"
              },
              {
                "type": "null"
              }
            ]
          },
          "result": true,
          "session_id": {
            "type": "string"
          },
          "status": {
            "$ref": "#/$defs/CommandStatus"
          }
        },
        "required": [
          "command_id",
          "session_id",
          "status"
        ],
        "type": "object"
      },
      "CommandStatus": {
        "description": "Accepted is durable acceptance; dispatched is local transport acceptance.\nNeither implies that a turn completed or that an uncertain action is safe to retry.",
        "enum": [
          "accepted",
          "dispatched",
          "failed",
          "outcome_unknown"
        ],
        "type": "string"
      },
      "PendingRequest": {
        "properties": {
          "expires_at_ms": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "kind": {
            "type": "string"
          },
          "payload": true,
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "kind",
          "payload",
          "expires_at_ms"
        ],
        "type": "object"
      },
      "SessionStatus": {
        "enum": [
          "opening",
          "running",
          "idle",
          "closing",
          "closed",
          "failed",
          "interrupted"
        ],
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "description": "Client input accepted by the host, separate from native agent output.",
        "properties": {
          "payload": {
            "properties": {
              "text": {
                "type": "string"
              }
            },
            "required": [
              "text"
            ],
            "type": "object"
          },
          "type": {
            "const": "input",
            "type": "string"
          }
        },
        "required": [
          "type",
          "payload"
        ],
        "type": "object"
      },
      {
        "properties": {
          "payload": true,
          "type": {
            "const": "agent",
            "type": "string"
          }
        },
        "required": [
          "type",
          "payload"
        ],
        "type": "object"
      },
      {
        "properties": {
          "payload": {
            "$ref": "#/$defs/SessionStatus"
          },
          "type": {
            "const": "state",
            "type": "string"
          }
        },
        "required": [
          "type",
          "payload"
        ],
        "type": "object"
      },
      {
        "properties": {
          "payload": {
            "$ref": "#/$defs/CommandReceipt"
          },
          "type": {
            "const": "command",
            "type": "string"
          }
        },
        "required": [
          "type",
          "payload"
        ],
        "type": "object"
      },
      {
        "properties": {
          "payload": {
            "$ref": "#/$defs/PendingRequest"
          },
          "type": {
            "const": "request",
            "type": "string"
          }
        },
        "required": [
          "type",
          "payload"
        ],
        "type": "object"
      },
      {
        "properties": {
          "payload": {
            "properties": {
              "reason": {
                "type": "string"
              },
              "request_id": {
                "type": "string"
              }
            },
            "required": [
              "request_id",
              "reason"
            ],
            "type": "object"
          },
          "type": {
            "const": "request_resolved",
            "type": "string"
          }
        },
        "required": [
          "type",
          "payload"
        ],
        "type": "object"
      },
      {
        "properties": {
          "payload": {
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": "object"
          },
          "type": {
            "const": "error",
            "type": "string"
          }
        },
        "required": [
          "type",
          "payload"
        ],
        "type": "object"
      },
      {
        "properties": {
          "payload": {
            "properties": {
              "protocol": {
                "type": "string"
              },
              "value": true
            },
            "required": [
              "protocol",
              "value"
            ],
            "type": "object"
          },
          "type": {
            "const": "native",
            "type": "string"
          }
        },
        "required": [
          "type",
          "payload"
        ],
        "type": "object"
      }
    ],
    "properties": {
      "host_id": {
        "type": "string"
      },
      "sequence": {
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "session_id": {
        "type": "string"
      },
      "timestamp_ms": {
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "turn_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "version": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "version",
      "host_id",
      "session_id",
      "sequence",
      "timestamp_ms"
    ],
    "title": "SessionEvent",
    "type": "object"
  },
  "protocol_version": 1,
